{
  "manifest_version": 3,
  "name": "DesignWan Capture",
  "version": "0.0.0",
  "description": "DesignWan local-first capture extension. Sends captures to Desktop via Native Messaging + Loopback Local Bridge.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DesignWan Capture"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "activeTab", "tabs"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:*"
  },
  "externally_connectable": {
    "ids": [],
    "matches": [],
    "accepts_tls_channel_id": false
  }
}
