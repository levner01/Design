{
  "name": "@designwan/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "DesignWan Electron Desktop 安全空壳。Sandboxed Renderer + Context Isolation + 窄 Preload Interface。",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "test": "echo 'no desktop tests yet (M0-01 skeleton)' && exit 0",
    "clean": "rimraf dist .tsbuildinfo release"
  },
  "dependencies": {
    "@designwan/contracts": "workspace:*",
    "@designwan/modules": "workspace:*",
    "@designwan/platform": "workspace:*",
    "@designwan/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
