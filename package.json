{
  "name": "designwan",
  "version": "0.0.0",
  "private": true,
  "description": "DesignWan local-first design cognition workbench (monorepo skeleton).",
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules .turbo || true",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "turbo run test",
    "depgraph": "node scripts/check-deps.mjs",
    "verify:quick": "node scripts/verify/verify-quick.mjs",
    "verify:local-data": "node scripts/verify/verify-local-data.mjs",
    "verify:desktop-security": "node scripts/verify/verify-desktop-security.mjs",
    "verify:bridge": "node scripts/verify/verify-bridge.mjs",
    "verify:contract": "node scripts/verify/verify-contract.mjs",
    "verify:evals:quick": "node scripts/verify/verify-evals-quick.mjs",
    "verify:e2e:p0a": "node scripts/verify/verify-e2e-p0a.mjs",
    "verify:e2e:p0b": "node scripts/verify/verify-e2e-p0b.mjs",
    "verify:release": "node scripts/verify/verify-release.mjs"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
