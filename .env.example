# DesignWan 环境变量示例
# 本地优先原则：默认全部为空；任何敏感值只存在于用户设备或 OS Keychain。
# 复制为 .env 后填入；.env 与 .env.* 永不进入 Git。

# 运行环境
NODE_ENV=development

# Electron Main 端口（仅开发热重载）
DESIGNWAN_DEV_PORT=5173

# 是否启用 DevTools（生产构建必须 false）
DESIGNWAN_DEV_TOOLS=false

# 日志级别
DESIGNWAN_LOG_LEVEL=info

# 可选 Control Plane（M0-05 才接入，默认空表示匿名本地模式）
DESIGNWAN_CONTROL_PLANE_URL=
DESIGNWAN_CONTROL_PLANE_ANON_KEY=

# Managed AI Gateway（M2-03 才接入，默认空表示禁用 Managed Route）
DESIGNWAN_MANAGED_GATEWAY_URL=

# BYOK Provider Key 永远不在环境变量中明文存储；只在 OS Keychain 通过 KeyProtector 引用。
# 这里仅作为占位说明，禁止填写真实 Key。
DESIGNWAN_BYOK_KEYCHAIN_REF_EXAMPLE=

# 本地数据库目录（仅开发期路径，生产由 app userData 决定）
DESIGNWAN_LOCAL_DATA_DIR=./app-data
